# ==== OTAK HERMANO ====
# ollama = AI lokal di laptop (gratis, offline)  |  claude = Claude API (butuh saldo)
BRAIN_BACKEND=ollama

# Model lokal (harus sudah: ollama pull <nama_model>)
#   RAM 8GB  -> qwen2.5:3b
#   RAM 16GB -> qwen2.5:7b   (rekomendasi)
#   alternatif -> llama3.1:8b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

# Cuma dipakai kalau BRAIN_BACKEND=claude
ANTHROPIC_API_KEY=

# ==== Identitas ====
USER_NAME=Aben

# ==== Model ====
MODEL_NAME=claude-sonnet-4-6
MAX_TOKENS=2048

# ==== Mode jalan: text / voice ====
RUN_MODE=text

# ==== Cara memanggil Hermano (mode suara): push_to_talk / wake_word ====
ACTIVATION=push_to_talk

# ==== Izin aksi berisiko: keyboard / voice ====
# keyboard = paling aman (orang lain di ruangan gak bisa nyetujuin aksi)
APPROVAL_METHOD=keyboard
VOICE_APPROVAL_PHRASE=setuju
# true = SEMUA aksi wajib minta izin, termasuk buka app/website
STRICT_MODE=false

# ==== Suara ====
WHISPER_MODEL=base
SPEECH_LANGUAGE=id
# pyttsx3 (offline) / edge (online, suara Indonesia natural)
TTS_ENGINE=pyttsx3
EDGE_VOICE=id-ID-ArdiNeural

# ==== Wake word (kalau ACTIVATION=wake_word) ====
PICOVOICE_ACCESS_KEY=
BUILT_IN_WAKE_WORD=jarvis
# isi kalau sudah bikin custom "Hermano" di console.picovoice.ai
WAKE_WORD_PATH=

# ==== Batas ====
MAX_HISTORY_MESSAGES=30
MAX_TOOL_STEPS=10
